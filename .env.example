# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
NEXT_PUBLIC_APP_URL="MY_APP_URL"

# Owner Password
OWNER_PASSWORD="master_password_for_owner"

# Telegram Bot configurations
TELEGRAM_BOT_TOKEN="your_bot_token"
TELEGRAM_ADMIN_GROUP_ID="-1000000000"
NEXT_PUBLIC_TELEGRAM_BOT_TOKEN="your_bot_token"
NEXT_PUBLIC_TELEGRAM_ADMIN_GROUP_ID="-1000000000"

# Supabase Configurations
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your_supabase_anon_key"

# Cloud SQL / Postgres Config
SQL_HOST="your_db_host"
SQL_DB_NAME="your_db_name"
SQL_USER="your_db_user"
SQL_PASSWORD="your_db_password"
SQL_ADMIN_USER="your_db_admin_user"
SQL_ADMIN_PASSWORD="your_db_admin_password"

# Cron Secret for Vercel Auth
CRON_SECRET="your_cron_secret"
